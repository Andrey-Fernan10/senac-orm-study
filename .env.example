# ===========================================
# Configuração do Banco de Dados (TypeORM)
# Preencha apenas estes dados para conectar
# ===========================================

# Tipo do banco: mysql | postgres | mariadb | sqlite
DB_TYPE=mysql

# Host do servidor (ex: localhost)
DB_HOST=localhost

# Porta (MySQL: 3306 | PostgreSQL: 5432)
DB_PORT=3306

# Nome do banco de dados
DB_NAME=senac_orm

# Usuário e senha
DB_USER=root
DB_PASSWORD=

# Em desenvolvimento: true cria/atualiza tabelas automaticamente a partir das entidades
# Em produção: use sempre false e migrations
DB_SYNC=true

# Mostra o SQL gerado pelo ORM no console (útil para aprender)
DB_LOGGING=true

# Porta da API
PORT=3000
